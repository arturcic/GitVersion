<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="GitVersion.Core;GitVersion.Git.Managed;GitVersion.LibGit2Sharp;LibGit2Sharp;Microsoft.Extensions.Logging.Abstractions;Microsoft.Extensions.Options;System.IO.Abstractions;TestableIO.System.IO.Abstractions;TestableIO.System.IO.Abstractions.Wrappers">
      <HintPath>$(BaselineDirectory)/%(Identity).dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="StageWindowsLibGit2" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Copy SourceFiles="$(BaselineDirectory)/runtimes/$(NETCoreSdkRuntimeIdentifier)/native/git2-5853918.dll"
          DestinationFolder="$(TargetDir)" />
  </Target>
</Project>
