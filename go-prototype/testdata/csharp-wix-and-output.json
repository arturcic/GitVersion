    "TaggedSemanticVersionRepositoryTests": {
      "source": "src/GitVersion.Core.Tests/Core/TaggedSemanticVersionRepositoryTests.cs",
      "sha256": "e64141f8f74b89c336858290d3e77b76e7ef64c10ecdf9a67b2b966badfd3c00",
      "go_test": "TestCSharpTaggedVersionFiltering",
      "methods": {
        "GetTaggedSemanticVersions_IgnoredAndEligibleTagsShareCommit_ReturnsOnlyEligibleTag": {
          "cases": [
            {
              "id": "case-000",
              "arguments": [],
              "tags": [
                "1.0.0",
                "2.0.0"
              ],
              "expected_tags": [
                "1.0.0"
              ],
              "patterns": [
                "^2\\.0\\.0$"
              ]
            }
          ]
        },
        "GetTaggedSemanticVersions_MultiplePatterns_UsesCaseInsensitiveOrSemanticsOnFriendlyName": {
          "cases": [
            {
              "id": "case-000",
              "arguments": [],
              "tags": [
                "v1.0.0",
                "v2.0.0",
                "v3.0.0"
              ],
              "expected_tags": [
                "v3.0.0"
              ],
              "patterns": [
                "^v1\\.",
                "^V2\\.",
                "^refs/tags/v3"
              ]
            }
          ]
        },
        "GetTaggedSemanticVersions_EmptyOrNonMatchingTags_PreservesCandidates": {
          "cases": [
            {
              "id": "case-000",
              "arguments": [
                null
              ],
              "tags": [
                "1.0.0"
              ],
              "expected_tags": [
                "1.0.0"
              ],
              "patterns": []
            },
            {
              "id": "case-001",
              "arguments": [
                "^preview-"
              ],
              "tags": [
                "1.0.0"
              ],
              "expected_tags": [
                "1.0.0"
              ],
              "patterns": [
                "^preview-"
              ]
            }
          ]
        }
      }
    },
    "BranchRepositoryTests": {
      "source": "src/GitVersion.Core.Tests/Core/BranchRepositoryTests.cs",
      "sha256": "b0ed20cf463bb98776d557e351d14e7c9f6c8e859a27ca6b45f3d464c583302e",
      "go_test": "TestCSharpCanonicalBranchIgnore",
      "methods": {
        "IsBranchIgnored_MatchesFriendlyNameWithoutRemoteName": {
          "cases": [
            {
              "id": "case-000",
              "arguments": [
                "refs/heads/release/legacy"
              ],
              "patterns": [
                "^release/legacy$"
              ]
            },
            {
              "id": "case-001",
              "arguments": [
                "refs/remotes/origin/release/legacy"
              ],
              "patterns": [
                "^release/legacy$"
              ]
            },
            {
              "id": "case-002",
              "arguments": [
                "refs/remotes/upstream/release/legacy"
              ],
              "patterns": [
                "^release/legacy$"
              ]
            }
          ]
        }
      }
    }
