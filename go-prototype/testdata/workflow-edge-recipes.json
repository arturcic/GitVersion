[
  {
    "id": "workflow-edge-release-own",
    "config": "workflow: GitFlow/v1\n",
    "description": "Release tag eligibility: own",
    "steps": [
      {
        "op": "commit",
        "id": "root"
      },
      {
        "op": "tag",
        "name": "1.2.3"
      },
      {
        "op": "branch",
        "name": "develop"
      },
      {
        "op": "checkout",
        "name": "develop"
      },
      {
        "op": "commit",
        "id": "dev"
      },
      {
        "op": "branch",
        "name": "release/next"
      },
      {
        "op": "checkout",
        "name": "release/next"
      },
      {
        "op": "commit",
        "id": "release"
      },
      {
        "op": "tag",
        "name": "2.0.0-beta.2",
        "annotated": true
      },
      {
        "op": "checkout",
        "name": "develop"
      },
      {
        "op": "checkpoint",
        "id": "release-exists"
      },
      {
        "op": "commit",
        "id": "next-dev"
      },
      {
        "op": "checkpoint",
        "id": "next-dev"
      },
      {
        "op": "checkout",
        "name": "main"
      },
      {
        "op": "merge",
        "id": "release-merge",
        "from": "release/next",
        "message": "Merge branch 'release/next'"
      },
      {
        "op": "checkout",
        "name": "develop"
      },
      {
        "op": "checkpoint",
        "id": "after-main-merge"
      }
    ]
  },
