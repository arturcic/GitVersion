  "suites": {
    "GitVersionExecutorTests": {
      "source": "src/GitVersion.Core.Tests/Core/GitVersionExecutorTests.cs",
      "sha256": "b1639f8e46c8da2db0f7a2c344833334c0b8315be1bec3c38969ec0f7ec6f224",
      "methods": {
        "CalculateVersionVariables_TwoBranchHasSameCommitHeadDetachedAndNotTagged_ThrowException": {
          "cases": [
            {
              "id": "case-000",
              "expected": [
                "Failed to try and guess branch to use. Move one of the branches along a commit to remove warning"
              ]
            }
          ]
        },
        "CalculateVersionVariables_TwoBranchHasSameCommitHeadDetachedAndTagged_ReturnSemver": {
          "cases": [
            {
              "id": "case-000",
              "expected": [
                "1.0.1",
                "1.0.1"
              ]
            }
          ]
        },
        "CalculateVersionVariables_ShallowFetch_ThrowException": {
          "cases": [
            {
              "id": "case-000",
              "expected": [
                "Repository is a shallow clone. Git repositories must contain the full history. See https://gitversion.net/docs/reference/requirements#unshallow for more info."
              ]
            }
          ]
        },
        "CalculateVersionVariables_ShallowFetch_WithAllowShallow_ShouldNotThrowException": {
          "cases": [
            {
              "id": "case-000",
              "expected": []
            }
          ]
        },
        "CalculateVersionVariables_WithLimitedCloneDepth_AndAllowShallowTrue_ShouldCalculateVersionCorrectly": {
          "cases": [
            {
              "id": "case-000",
              "expected": [
                "2.0.0",
                "1.0.0"
              ]
            }
          ]
        }
      }
    },
