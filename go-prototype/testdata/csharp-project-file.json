  "methods": {
    "CanUpdateProjectFileWithSdkProjectFileXml": [
      {
        "id": "case-000",
        "xml": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n  </PropertyGroup>\n</Project>",
        "can_update": true,
        "warning": ""
      },
      {
        "id": "case-001",
        "xml": "<Project Sdk=\"Microsoft.NET.Sdk.Worker\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n  </PropertyGroup>\n</Project>",
        "can_update": true,
        "warning": ""
      },
      {
        "id": "case-002",
        "xml": "<Project Sdk=\"Microsoft.NET.Sdk.Web\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n  </PropertyGroup>\n</Project>",
        "can_update": true,
        "warning": ""
      },
      {
        "id": "case-003",
        "xml": "<Project Sdk=\"Microsoft.NET.Sdk.WindowsDesktop\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n  </PropertyGroup>\n</Project>",
        "can_update": true,
        "warning": ""
      },
      {
        "id": "case-004",
        "xml": "<Project Sdk=\"Microsoft.NET.Sdk.Razor\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n  </PropertyGroup>\n</Project>",
        "can_update": true,
        "warning": ""
      },
      {
        "id": "case-005",
        "xml": "<Project Sdk=\"Microsoft.NET.Sdk.BlazorWebAssembly\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n  </PropertyGroup>\n</Project>",
        "can_update": true,
        "warning": ""
      },
      {
        "id": "case-006",
        "xml": "<Project Sdk=\"Microsoft.Build.Sql\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n  </PropertyGroup>\n</Project>",
        "can_update": true,
        "warning": ""
      }
    ],
    "CannotUpdateProjectFileWithIncorrectProjectSdk": [
      {
        "id": "case-000",
        "xml": "<Project Sdk=\"SomeOtherProject.Sdk\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n  </PropertyGroup>\n</Project>",
        "can_update": false,
        "warning": "Specified project file Sdk (SomeOtherProject.Sdk) is not supported, please ensure the project sdk starts with 'Microsoft.NET.Sdk' or 'Microsoft.Build.Sql'"
      }
    ],
    "CannotUpdateProjectFileWithMissingProjectSdk": [
      {
        "id": "case-000",
        "xml": "<Project>\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n  </PropertyGroup>\n</Project>",
        "can_update": false,
        "warning": "Project file does not specify a Sdk attribute, please ensure the project sdk starts with 'Microsoft.NET.Sdk' or 'Microsoft.Build.Sql'"
      }
    ],
    "CannotUpdateProjectFileWithoutAssemblyInfoGeneration": [
      {
        "id": "case-000",
        "xml": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>\n  </PropertyGroup>\n</Project>",
        "can_update": false,
        "warning": "Project file specifies <GenerateAssemblyInfo>false</GenerateAssemblyInfo>: versions set in this project file will not affect the output artifacts"
      }
    ],
    "CannotUpdateProjectFileWithoutAPropertyGroup": [
      {
        "id": "case-000",
        "xml": "<Project Sdk=\"Microsoft.NET.Sdk\">\n</Project>",
        "can_update": false,
        "warning": "Unable to locate any <PropertyGroup> elements in specified project file. Are you sure it is in a correct format?"
      }
    ],
    "UpdateProjectXmlVersionElementWithStandardXmlInsertsElement": [
      {
        "id": "case-000",
        "xml": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n  </PropertyGroup>\n</Project>",
        "expected_xml": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n    <AssemblyVersion>2.0.0.0</AssemblyVersion>\n  </PropertyGroup>\n</Project>"
      }
    ],
    "UpdateProjectXmlVersionElementWithStandardXmlModifiesElement": [
      {
        "id": "case-000",
        "xml": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n    <AssemblyVersion>1.0.0.0</AssemblyVersion>\n  </PropertyGroup>\n</Project>",
        "expected_xml": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n    <AssemblyVersion>2.0.0.0</AssemblyVersion>\n  </PropertyGroup>\n</Project>"
      }
    ],
    "UpdateProjectXmlVersionElementWithDuplicatePropertyGroupsModifiesLastElement": [
      {
        "id": "case-000",
        "xml": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n    <AssemblyVersion>1.0.0.0</AssemblyVersion>\n  </PropertyGroup>\n  <PropertyGroup>\n    <AssemblyVersion>1.0.0.0</AssemblyVersion>\n  </PropertyGroup>\n</Project>",
        "expected_xml": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n    <AssemblyVersion>1.0.0.0</AssemblyVersion>\n  </PropertyGroup>\n  <PropertyGroup>\n    <AssemblyVersion>2.0.0.0</AssemblyVersion>\n  </PropertyGroup>\n</Project>"
      }
    ],
    "UpdateProjectXmlVersionElementWithMultipleVersionElementsLastOneIsModified": [
      {
        "id": "case-000",
        "xml": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n    <AssemblyVersion>1.0.0.0</AssemblyVersion>\n    <AssemblyVersion>1.0.0.0</AssemblyVersion>\n  </PropertyGroup>\n</Project>",
        "expected_xml": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n    <AssemblyVersion>1.0.0.0</AssemblyVersion>\n    <AssemblyVersion>2.0.0.0</AssemblyVersion>\n  </PropertyGroup>\n</Project>"
      }
    ],
    "UpdateProjectFileAddsVersionToFile": [
      {
        "id": "case-000",
        "xml": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <TargetFramework>net10.0</TargetFramework>\n  </PropertyGroup>\n</Project>",
        "file_name": "TestProject.csproj",
        "expected_xml": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <TargetFramework>net10.0</TargetFramework>\n    <AssemblyVersion>2.3.1.0</AssemblyVersion>\n    <FileVersion>2.3.1.0</FileVersion>\n    <InformationalVersion>2.3.1+3.Branch.foo.Sha.hash</InformationalVersion>\n    <Version>2.3.1</Version>\n  </PropertyGroup>\n</Project>"
      },
      {
        "id": "case-001",
        "xml": "<Project Sdk=\"Microsoft.Build.Sql\">\n  <PropertyGroup>\n    <TargetFramework>net10.0</TargetFramework>\n  </PropertyGroup>\n</Project>",
        "file_name": "TestProject.sqlproj",
        "expected_xml": "<Project Sdk=\"Microsoft.Build.Sql\">\n  <PropertyGroup>\n    <TargetFramework>net10.0</TargetFramework>\n    <AssemblyVersion>2.3.1.0</AssemblyVersion>\n    <FileVersion>2.3.1.0</FileVersion>\n    <InformationalVersion>2.3.1+3.Branch.foo.Sha.hash</InformationalVersion>\n    <Version>2.3.1</Version>\n  </PropertyGroup>\n</Project>"
      }
    ]
  }
}
