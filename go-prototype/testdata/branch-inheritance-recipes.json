  {
    "id": "inheritance-pr-local-and-origin",
    "description": "local-and-origin",
    "config": "{\"workflow\": \"GitFlow/v1\", \"calculation\": {\"branches\": {\"main\": {\"increment\": \"Minor\"}}}}",
    "steps": [
      {
        "op": "commit",
        "id": "root"
      },
      {
        "op": "tag",
        "name": "1.0.0"
      },
      {
        "op": "branch",
        "name": "support/v1.0.x"
      },
      {
        "op": "branch",
        "name": "hotfix/v1.0.2"
      },
      {
        "op": "checkout",
        "name": "hotfix/v1.0.2"
      },
      {
        "op": "commit",
        "id": "fix"
      },
      {
        "op": "checkout",
        "name": "main"
      },
      {
        "op": "commit",
        "id": "main-work"
      },
      {
        "op": "remote-branch",
        "name": "origin/support/v1.0.x",
        "from": "support/v1.0.x"
      },
      {
        "op": "branch",
        "name": "pull/2/merge"
      },
      {
        "op": "checkout",
        "name": "pull/2/merge"
      },
      {
        "op": "merge",
        "id": "pull-merge",
        "from": "hotfix/v1.0.2",
        "message": "Merge pull request 2 from hotfix/v1.0.2 into support/v1.0.x"
      },
      {
        "op": "checkpoint",
        "id": "head"
      }
    ]
  },
