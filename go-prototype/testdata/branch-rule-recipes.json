    "config": "{\"workflow\": \"GitFlow/v1\", \"calculation\": {\"branches\": {\"main\": {\"regex\": \"^trunk$\", \"label\": \"alpha\"}}}}",
    "steps": [
      {
        "op": "commit",
        "id": "root"
      },
      {
        "op": "checkpoint",
        "id": "head"
      }
    ],
    "initial_branch": "trunk"
  },
