[
  {
    "id": "branch-rule-case-insensitive",
    "description": "case-insensitive",
    "config": "{\"workflow\": \"GitFlow/v1\", \"calculation\": {\"branches\": {\"custom\": {\"regex\": \"^custom/(?<BranchName>.+)\", \"label\": \"{BranchName}\", \"increment\": \"None\"}}}}",
    "steps": [
      {
        "op": "commit",
        "id": "root"
      },
      {
        "op": "branch",
        "name": "CUSTOM/Foo"
      },
      {
        "op": "checkout",
        "name": "CUSTOM/Foo"
      },
      {
        "op": "commit",
        "id": "work"
      },
      {
        "op": "checkpoint",
        "id": "head"
      }
    ]
  },
  {
    "id": "branch-rule-main-regex",
