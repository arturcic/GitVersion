  {
    "id": "branch-rule-inherited-main",
    "description": "Inherit nullable mode and tagged-commit behavior from main",
    "config": "{\"workflow\": \"GitFlow/v1\", \"calculation\": {\"branches\": {\"main\": {\"mode\": \"ManualDeployment\", \"increment\": \"Minor\", \"prevent-increment\": {\"when-current-commit-tagged\": false}}, \"custom\": {\"regex\": \"^custom/(?<BranchName>.+)\", \"label\": \"{BranchName}\", \"increment\": \"Inherit\", \"source-branches\": [\"main\"]}}}}",
    "steps": [
      {
        "op": "commit",
        "id": "root"
      },
      {
        "op": "branch",
        "name": "custom/topic"
      },
      {
        "op": "checkout",
        "name": "custom/topic"
      },
      {
        "op": "commit",
        "id": "work"
      },
      {
        "op": "tag",
        "name": "1.2.0-topic.1"
      },
      {
        "op": "checkpoint",
        "id": "tagged"
      },
      {
        "op": "commit",
        "id": "after"
      },
      {
        "op": "checkpoint",
        "id": "after"
      }
    ]
  },
